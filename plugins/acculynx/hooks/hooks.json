{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/apply-user-config.mjs"],
            "timeout": 10,
            "statusMessage": "Applying AccuLynx plugin settings"
          }
        ]
      }
    ]
  }
}
